---
import { copy, type Lang } from '../lib/content';
import { APP_STORE_URL } from '../lib/config';
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const base = import.meta.env.BASE_URL;
const screenshots = join(process.cwd(), 'public/screenshots');
const files = existsSync(screenshots) ? readdirSync(screenshots) : [];
function src(prefix: string) {
  const find = (locale: Lang) => {
    const exact = `${prefix}.${locale}.png`;
    return files.includes(exact) ? exact : files.find((name) => name.startsWith(`${prefix}-`) && name.endsWith(`.${locale}.png`));
  };
  const match = find(lang) ?? (lang === 'zh' ? find('en') : undefined);
  return match ? `${base}screenshots/${match}` : null;
}
---
<section class="hero">
  <div class="container hero-inner">
    <img class="hero-icon" src={`${base}brand/videoex-icon.png`} width="100" height="100" alt="" fetchpriority="high" />
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>videoEx <span>{t.hero.headline}</span></h1>
    <p class="hero-intro">{t.hero.intro}</p>
    {APP_STORE_URL ? <a class="status-pill" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">App Store ↗</a> : <span class="status-pill" role="status">{t.hero.coming}</span>}
    <p class="purchase">{t.hero.purchase}</p>
    <p class="platforms">{t.hero.platforms}</p>
    <div class="hero-stage" aria-label={lang === 'zh' ? '产品截图' : 'Product screenshots'}>
      <div class="device device-mac">{src('hero-mac') ? <img src={src('hero-mac')!} alt={lang === 'zh' ? 'Mac 上的 videoEx' : 'videoEx on Mac'} width="1600" height="1000" /> : <div class="placeholder">{t.imagePending}</div>}</div>
      <div class="device device-phone">{src('hero-iphone') ? <img src={src('hero-iphone')!} alt={lang === 'zh' ? 'iPhone 上的 videoEx' : 'videoEx on iPhone'} width="900" height="1900" /> : <div class="placeholder">{t.imagePending}</div>}</div>
    </div>
  </div>
</section>
<p class="scope container">{t.hero.scope}</p>
<section id="features" class="features container">
  <h2 class="section-heading">{t.overview}</h2>
  {t.features.map((item) => <div class="feature">
    <div class="feature-copy">
      <span class="feature-number">{item.number} / {item.kicker}</span>
      <h3>{item.title}</h3>
      <p>{item.body}</p>
    </div>
    <div class="feature-image">{src(item.image) ? <img src={src(item.image)!} alt={item.alt} loading="lazy" width="1600" height="1000" /> : <div class="placeholder">{t.imagePending}</div>}</div>
  </div>)}
</section>
<aside class="closing container">
  <h2>{t.closing}</h2>
  <div class="closing-links"><a href={`${base}${lang}/support/`}>{t.faqLink}</a><a href={`${base}${lang}/privacy/`}>{t.privacyLink}</a></div>
</aside>
