---
import { copy, type Lang } from '../lib/content';
const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const toEn = path.replace(/\/(en|zh)(\/|$)/, '/en$2');
const toZh = path.replace(/\/(en|zh)(\/|$)/, '/zh$2');
---
<header class="site-header">
  <nav class="container site-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
    <a class="brand" href={`${base}${lang}/`}><img src={`${base}brand/videoex-icon.png`} width="32" height="32" alt="" />videoEx</a>
    <div class="nav-links">
      <a class="nav-feature" href={`${base}${lang}/#features`}>{copy[lang].nav.features}</a>
      <a href={`${base}${lang}/privacy/`}>{copy[lang].nav.privacy}</a>
      <a href={`${base}${lang}/support/`}>{copy[lang].nav.support}</a>
      <span class="lang"><a href={toEn} class={lang === 'en' ? 'active' : ''} lang="en" aria-label="English">EN</a><span>/</span><a href={toZh} class={lang === 'zh' ? 'active' : ''} lang="zh-Hans" aria-label="简体中文">中文</a></span>
    </div>
  </nav>
</header>
