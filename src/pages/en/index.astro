---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0b0d17" />
  <link rel="icon" type="image/svg+xml" href={`${base}brand/favicon.svg`} />
  <title>videoEx — Watch web video in Safari at your own pace</title>
  <style>
    :root{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#f4f3ff;background:#0b0d17}
    body{min-height:100vh;margin:0;background:radial-gradient(ellipse at 50% -20%,#3c3981,#0b0d17 62%)}
    main{max-width:680px;margin:0 auto;padding:12vh 24px;text-align:center}
    img{width:100px;height:100px;border-radius:22px}h1{font-size:clamp(2.2rem,6vw,4rem);letter-spacing:-.05em;margin:22px 0 10px}p{color:#cfcee1;line-height:1.6}
    a{color:#c3c0ff}nav{margin-top:40px;display:flex;justify-content:center;gap:25px;flex-wrap:wrap}
  </style>
</head><body><main>
  <img src={`${base}brand/videoex-icon.png`} alt="videoEx icon" />
  <h1>videoEx</h1>
  <p>Watch web video in Safari at your own pace.</p>
  <p>Coming soon to the App Store.</p>
  <nav><a href={`${base}demo/`}>Try the demo</a><a href={`${base}en/privacy/`}>Privacy</a><a href={`${base}en/support/`}>Support</a></nav>
</main></body></html>
